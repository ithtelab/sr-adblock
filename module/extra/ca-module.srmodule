#!name=🅲🅴🆁🆃🅷🆄🅱 证书模块
#!desc=需要以编辑参数的方式启用并填写完整
#!author=LOWERTOP（本仓库仅本地化脚本并重新发布）
#!icon=https://raw.githubusercontent.com/LOWERTOP/Shadowrocket-First/main/img/Shadowrocket_icon.png
#!homepage=https://github.com/LOWERTOP/Shadowrocket-First
#!update=2026-09-26
#!arguments=证书模块:false, 启用h2解密:false, 证书内容:此处粘贴有效的证书内容, 证书密码:Shadowrocket, 插入解密主机:英文逗号分隔主机名, 主机插入方式:%APPEND%
#!arguments-desc=证书模块：启用并填写证书内容方可生效\n\n启用h2解密：默认为关，此选项将覆盖配置文件中的相关设置\n\n证书内容：粘贴自有效证书\n\n证书密码：若默认密码是Shadowrocket可不动\n\n插入解密主机：补充解密主机或排除解密主机\n\n主机插入方式：支持%APPEND%和%INSERT%\n\n排除解密示例：-www.apple.com,-www.baidu.com

# ==========================================================================
#  本文件由 sr-adblock-factory 合并生成，请勿手工编辑
#  生成时间: 2026-09-26 07:16:51
#
#  合并来源：
#    - LOWERTOP/Shadowrocket-First/main/CA.sgmodule
#    - 来源：https://github.com/LOWERTOP/Shadowrocket-First
#
#  规模：
#    [MITM]                 5
#    MITM 主机名               5
#
#  在小火箭里的装法：
#    装好后点模块的「编辑参数」，把证书内容与密码填进去，再打开「证书模块」开关
# ==========================================================================

[MITM]
enable={{{证书模块}}}
h2 = {{{启用h2解密}}}
ca-passphrase={{{证书密码}}}
ca-p12={{{证书内容}}}
hostname = {{{主机插入方式}}} {{{插入解密主机}}}
