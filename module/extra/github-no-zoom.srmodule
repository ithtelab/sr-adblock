[Script]
GitHub iOS 防自动缩放 = type=http-response,pattern=^https?:\/\/github\.com\/[^\/]+\/[^\/]+(?:\/.*)?$,requires-body=1,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/ithtelab/sr-adblock/release/vendor/LOWERTOP/Shadowrocket-First/main/JS/github-ios-no-zoom.js,timeout=10

[MITM]
hostname = %APPEND% github.com
