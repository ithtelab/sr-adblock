#    - 已本地化 1 个脚本
#
#  规模：
#    [Script]               1
#    MITM 主机名               0
#
#  在小火箭里的装法：
#    导入方式：小火箭 → 配置 → 模块 → 右上角 + → 粘贴本文件链接
# ==========================================================================

[Script]
网络信息变化 𝕏 = enable={{{ACTIVE}}},type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/ithtelab/sr-adblock/release/vendor/xream/scripts/main/surge/modules/network-info/net-lsp-x.js,argument="TYPE=EVENT&SSID={{{SSID}}}&IPv6={{{IPv6}}}&MASK={{{MASK}}}&DOMESTIC_IPv4={{{DOMESTIC_IPv4}}}&DOMESTIC_IPv6={{{DOMESTIC_IPv6}}}&LANDING_IPv4={{{LANDING_IPv4}}}&LANDING_IPv6={{{LANDING_IPv6}}}&PRIVACY={{{PRIVACY}}}&FLAG={{{FLAG}}}&ASN={{{ASN}}}&ORG={{{ORG}}}&DOMESTIC_IPv4_KEY={{{DOMESTIC_IPv4_KEY}}}&LANDING_IPv4_KEY={{{LANDING_IPv4_KEY}}}",timeout=30
