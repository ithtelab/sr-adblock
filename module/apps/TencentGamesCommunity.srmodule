[URL Rewrite]
# 如果想拦截1234567890-1234?wx类的长连接就加长规则,不加结尾符,只要前面的匹配了都会拦截。
^https?:\/\/static\.gameplus\.qq\.com\/img\/\d{10}-\d{4}$ - reject

[MITM]
hostname = %APPEND% static.gameplus.qq.com
