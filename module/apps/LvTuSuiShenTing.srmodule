[Map Local]
^https?:\/\/www\.1314zhilv\.com\/ltsstnew\/(guideScenic\/getRecentlyUpdatedScenic|city\/getWeatherByCityName) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# 首页北京城市导览图片,首页上方轮播图片净化
旅途随身听 = type=http-response,pattern=^https?:\/\/www\.1314zhilv\.com\/ltsstnew\/(common\/getJGQIconNew|city\/getAllBannelByCity),script-path=https://raw.githubusercontent.com/ithtelab/sr-adblock/release/vendor/fmz200/wool_scripts/main/Scripts/lvtusuishenting/ltsst-ad.js,requires-body=true,timeout=60

