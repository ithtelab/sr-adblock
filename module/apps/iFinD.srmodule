#!name=iFinD 去广告
#!desc=只针对 iFinD 的去广告模块，出问题时可以单独停用而不影响其他 App
#!author=sr-adblock-factory（原始规则来自 可莉/奶思 wool_scripts）
#!homepage=https://raw.githubusercontent.com/ithtelab/sr-adblock
#!update=2026-09-26

# ==========================================================================
#  本文件由 sr-adblock-factory 合并生成，请勿手工编辑
#  生成时间: 2026-09-26 07:16:51
#
#  合并来源：
#    - fmz200/wool_scripts split/partT/iFinD.sgmodule
#
#  规模：
#    [Rule]                 3
#    [URL Rewrite]          1
#    [Map Local]            2
#    [MITM]                 1
#
#  在小火箭里的装法：
#    只想去掉 iFinD 的广告、不想装总模块时用这个
#    导入方式与总模块相同（配置 → 模块 → + → 粘贴链接）
# ==========================================================================

[Rule]
DOMAIN,adm.10jqka.com.cn,REJECT
DOMAIN,stat.10jqka.com.cn,REJECT
DOMAIN-SUFFIX,ad.thsi.cn,REJECT

[URL Rewrite]
^https?:\/\/iphone\.ac\.qq\.com\/.*\/Support\/(getSystemConf|bootScreen) - reject

[Map Local]
^https?:\/\/adm\.10jqka\.com\.cn\/interface\/ad\/recommend data-type=text data=" " status-code=200
# 同花顺至尊版 感谢【梭哈 All in】分享
^https?:\/\/stat\.10jqka\.com\.cn\/q\?ld=mobile&id=ad data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% adm.10jqka.com.cn, iphone.ac.qq.com, stat.10jqka.com.cn
