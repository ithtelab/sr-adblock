#!name=Google 去广告
#!desc=只针对 Google 的去广告模块，出问题时可以单独停用而不影响其他 App
#!author=sr-adblock-factory（原始规则来自 可莉/奶思 wool_scripts）
#!homepage=https://raw.githubusercontent.com/ithtelab/sr-adblock
#!update=2026-09-26

# ==========================================================================
#  本文件由 sr-adblock-factory 合并生成，请勿手工编辑
#  生成时间: 2026-09-26 07:16:51
#
#  合并来源：
#    - fmz200/wool_scripts split/partG/Google.sgmodule
#
#  规模：
#    [Rule]                 52
#    [Map Local]            4
#    [MITM]                 1
#
#  在小火箭里的装法：
#    只想去掉 Google 的广告、不想装总模块时用这个
#    导入方式与总模块相同（配置 → 模块 → + → 粘贴链接）
# ==========================================================================

[Rule]
DOMAIN-SUFFIX,google-analytics.com,REJECT
DOMAIN,safebrowsing.googleapis.com,REJECT
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,doubleclick.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,googleadsserving.cn,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googletagservices.com,REJECT
DOMAIN-SUFFIX,googletagmanager.com,REJECT
DOMAIN-SUFFIX,video-ad-stats.googlesyndication.com,REJECT
DOMAIN-SUFFIX,tpc.googlesyndication.com,REJECT
DOMAIN-SUFFIX,pagead.google.com,REJECT
DOMAIN-SUFFIX,pagead.l.google.com,REJECT
DOMAIN-SUFFIX,pagead2.googlesyndication.com,REJECT
DOMAIN-SUFFIX,pagead-tpc.l.google.com,REJECT
DOMAIN-SUFFIX,mobileads.google.com,REJECT
DOMAIN-SUFFIX,googlecommerce.com,REJECT
DOMAIN-SUFFIX,blaaaa12.googlecode.com,REJECT
DOMAIN-SUFFIX,badad.googleplex.com,REJECT
DOMAIN-SUFFIX,afs.googlesyndication.com,REJECT
DOMAIN-SUFFIX,afd.l.google.com,REJECT
DOMAIN-SUFFIX,www.googleadservices.com,REJECT
DOMAIN-SUFFIX,www.google-analytics.com,REJECT
DOMAIN,ads.youtube.com,REJECT
DOMAIN-SUFFIX,cmshow.gtimg.cn,REJECT
DOMAIN-SUFFIX,discuz.gtimg.cn,REJECT
DOMAIN-SUFFIX,gu.qlogo.cn,REJECT
DOMAIN-SUFFIX,py.qlogo.cn,REJECT
DOMAIN-SUFFIX,py2.qlogo.cn,REJECT
DOMAIN-SUFFIX,app-measurement.com,REJECT
DOMAIN-SUFFIX,admob.com,REJECT
DOMAIN-SUFFIX,crashlytics.com,REJECT
DOMAIN-SUFFIX,pagespeed-mod,REJECT
DOMAIN-SUFFIX,csi.gstatic.com,REJECT
DOMAIN-SUFFIX,beacon.gtimg.com,REJECT
DOMAIN-SUFFIX,bla.gtimg.com,REJECT
DOMAIN-SUFFIX,lb.gtimg.com,REJECT
DOMAIN-SUFFIX,pgdt.gtimg.com,REJECT
DOMAIN-SUFFIX,ra.gtimg.com,REJECT
DOMAIN-SUFFIX,splashqqlive.gtimg.com,REJECT
DOMAIN-SUFFIX,swa.gtimg.com,REJECT
DOMAIN-SUFFIX,tui.gtimg.com,REJECT
DOMAIN-SUFFIX,wa.gtimg.com,REJECT
DOMAIN-SUFFIX,wb.gtimg.com,REJECT
DOMAIN-SUFFIX,e.crashlytics.com,REJECT
DOMAIN-SUFFIX,setting.crashlytics.com,REJECT
DOMAIN-SUFFIX,settings.crashlytics.com,REJECT
DOMAIN-SUFFIX,gcdn.2mdn.net,REJECT
DOMAIN-SUFFIX,s0.2mdn.net,REJECT
DOMAIN-SUFFIX,s1.2mdn.net,REJECT
DOMAIN-SUFFIX,pgdt.ugdtimg.com,REJECT
DOMAIN-SUFFIX,adclick.g.doublecklick.net,REJECT

[Map Local]
# 如开启可自行添加主机名，但似乎已不可MITM
^https?:\/\/.+\.googleapis.com/.+ad_break data-type=tiny-gif status-code=200
^https?:\/\/.+\.googleapis.com/.+log_event data-type=tiny-gif status-code=200
^https?:\/\/.+\.googleapis.com/adsmeasurement data-type=tiny-gif status-code=200
^https?:\/\/pagead2\.googlesyndication\.com\/pagead\/ data-type=tiny-gif status-code=200

[MITM]
hostname = %APPEND% pagead2.googlesyndication.com
