[Rule]
DOMAIN-SUFFIX,ad.sohu.com,REJECT
DOMAIN-SUFFIX,ads.sohu.com,REJECT
DOMAIN-SUFFIX,aty.sohu.com,REJECT
DOMAIN,hui.sohu.com,REJECT
DOMAIN-SUFFIX,adnet.sohu.com,REJECT
