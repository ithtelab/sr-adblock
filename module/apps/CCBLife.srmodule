#!name=CCBLife 去广告
#!desc=只针对 CCBLife 的去广告模块，出问题时可以单独停用而不影响其他 App
#!author=sr-adblock-factory（原始规则来自 可莉/奶思 wool_scripts）
#!homepage=https://raw.githubusercontent.com/ithtelab/sr-adblock
#!update=2026-09-26

# ==========================================================================
#  本文件由 sr-adblock-factory 合并生成，请勿手工编辑
#  生成时间: 2026-09-26 07:16:51
#
#  合并来源：
#    - fmz200/wool_scripts split/partJ/CCBLife.sgmodule
#
#  规模：
#    [Rule]                 1
#    [URL Rewrite]          2
#    [Body Rewrite]         2
#    [Map Local]            4
#    [Script]               2
#    [MITM]                 1
#
#  在小火箭里的装法：
#    只想去掉 CCBLife 的广告、不想装总模块时用这个
#    导入方式与总模块相同（配置 → 模块 → + → 粘贴链接）
# ==========================================================================

[Rule]
# 内置饿了么外卖弹窗, REJECT
DOMAIN,o2o-ad-log-gateway.alibaba.com,REJECT

[URL Rewrite]
^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.alsc\.wamai\.store\.detail\.miniapp\.popup - reject
^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.venus\.shopcouponpopupservice\.getshopcouponspopup - reject

[Body Rewrite]
http-response ^https?:\/\/yunbusiness\.ccb\.com\/basic_service\/txCtrl\? "TAG_AD_INFO" "fmz200"
http-response ^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.venus\.shopresourceservice\.getshopresource posterList fmz200

[Map Local]
# 首页横幅广告
^https?:\/\/yunbusiness\.ccb\.com\/clp_service\/txCtrl\?txcode=A3341A(002|006|009|119|120) data-type=text data=" " status-code=200
^https?:\/\/yunbusiness\.ccb\.com\/clp_service\/txCtrl\?txcode=A3341C147 data-type=text data=" " status-code=200
# 内置饿了么
^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.alsc\.eleme\.\w+\.trigger\.respond data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/yunbusiness\.ccb\.com\/basic_service\/txCtrl\?txcode=A3341AB05 data-type=file data="https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/ccbLife/A3341AB05.json" status-code=200 header="Content-Type:application/json"

[Script]
建行生活 = type=http-response,pattern=^https?:\/\/yunbusiness\.ccb\.com\/basic_service\/txCtrl\?txcode=A3341AB04,script-path=https://raw.githubusercontent.com/ithtelab/sr-adblock/release/vendor/fmz200/wool_scripts/main/Scripts/ccbLife/ccbLifeAds.js,requires-body=true,timeout=60
# 内置饿了么
建行生活内置饿了么 = type=http-response,pattern=^https?:\/\/g\.alicdn\.com\/.*o2o-ad,script-path=https://raw.githubusercontent.com/ithtelab/sr-adblock/release/vendor/zirawell/R-Store/main/Res/Scripts/AntiAd/alicdn.js,requires-body=true,timeout=60

[MITM]
hostname = %APPEND% yunbusiness.ccb.com, g.alicdn.com, waimai-guide.ele.me
