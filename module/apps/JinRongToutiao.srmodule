[Rule]
DOMAIN-KEYWORD,clk.gentags.net,REJECT
DOMAIN-KEYWORD,dm.pstatp.com,REJECT
DOMAIN-KEYWORD,dm.bytedance.com,REJECT
DOMAIN-KEYWORD,uop.umeng.com,REJECT
DOMAIN-KEYWORD,m.suning.com,REJECT
DOMAIN-KEYWORD,adshare.toutiao.com,REJECT
DOMAIN-KEYWORD,tunion-api.m.taobao.com,REJECT
DOMAIN-KEYWORD,s1.pstatp.com,REJECT
DOMAIN-KEYWORD,s2.pstatp.com,REJECT
DOMAIN-KEYWORD,s3.pstatp.com,REJECT
DOMAIN-KEYWORD,a3.pstatp.com,REJECT
DOMAIN-KEYWORD,a3.bytecdn.cn,REJECT
DOMAIN-SUFFIX,ad.toutiao.com,REJECT
DOMAIN-SUFFIX,dm.toutiao.com,REJECT
DOMAIN-SUFFIX,dsp.toutiao.com,REJECT
DOMAIN-SUFFIX,nativeapp.toutiao.com,REJECT
DOMAIN-SUFFIX,partner.toutiao.com,REJECT
DOMAIN-SUFFIX,track.toutiao.com,REJECT
DOMAIN-SUFFIX,dm.pstatp.com,REJECT
DOMAIN-SUFFIX,pb3.pstatp.com,REJECT
