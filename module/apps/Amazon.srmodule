#!name=Amazon 去广告
#!desc=只针对 Amazon 的去广告模块，出问题时可以单独停用而不影响其他 App
#!author=sr-adblock-factory（原始规则来自 可莉/奶思 wool_scripts）
#!homepage=https://raw.githubusercontent.com/ithtelab/sr-adblock
#!update=2026-09-26

# ==========================================================================
#  本文件由 sr-adblock-factory 合并生成，请勿手工编辑
#  生成时间: 2026-09-26 07:16:51
#
#  合并来源：
#    - fmz200/wool_scripts split/partA/Amazon.sgmodule
#
#  规模：
#    [Rule]                 10
#    [Map Local]            2
#    [MITM]                 1
#
#  在小火箭里的装法：
#    只想去掉 Amazon 的广告、不想装总模块时用这个
#    导入方式与总模块相同（配置 → 模块 → + → 粘贴链接）
# ==========================================================================

[Rule]
DOMAIN-SUFFIX,amazon-adsystem.com,REJECT
DOMAIN-SUFFIX,mads.amazon.com,REJECT
DOMAIN-SUFFIX,sdb.amazonaws.com,REJECT
DOMAIN-SUFFIX,airpushmarketing.s3.amazonaws.com,REJECT
DOMAIN-SUFFIX,epowernetworktrackerimages.s3.amazonaws.com,REJECT
DOMAIN-SUFFIX,gateways.s3.amazonaws.com,REJECT
DOMAIN-SUFFIX,kbnetworkz.s3.amazonaws.com,REJECT
DOMAIN-SUFFIX,secretmedia.s3.amazonaws.com,REJECT
DOMAIN-SUFFIX,smblock.s3.amazonaws.com,REJECT
DOMAIN-SUFFIX,whistleout.s3.amazonaws.com,REJECT

[Map Local]
^https?:\/\/api-cslp-emt\.amazon\.cn\/gateway\/content\/widget\/popup data-type=text data=" " status-code=200
^https?:\/\/api-cslp-emt\.amazon\.cn\/gateway\/recommend data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api-cslp-emt.amazon.cn
