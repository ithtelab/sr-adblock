# ==========================================================================
#  本文件由 sr-adblock-factory 合并生成，请勿手工编辑
#  生成时间: 2026-09-26 07:16:51
#
#  合并来源：
#    - fmz200/wool_scripts split/partW/NetEaseKaola.sgmodule
#
#  规模：
#    [URL Rewrite]          1
#    [Map Local]            2
#    [MITM]                 1
#
#  在小火箭里的装法：
#    只想去掉 NetEaseKaola 的广告、不想装总模块时用这个
#    导入方式与总模块相同（配置 → 模块 → + → 粘贴链接）
# ==========================================================================

[URL Rewrite]
^https?:\/\/gw\.kaola\.com\/gw\/dgmobile\/newOpenAd - reject

[Map Local]
^https?:\/\/kaola-haitao\.oss\.kaolacdn.com\/.+?_\d{3,4}_\d{4}\.jpg\?x-oss-process=image\/resize,m_mfit,w_\d{3,4},h_\d{4}\/format,webp\/quality,Q_85 data-type=text data=" " status-code=200
^https?:\/\/sp\.kaola\.com\/api\/openad data-type=text data=" " status-code=200

[MITM]
hostname = %APPEND% kaola-haitao.oss.kaolacdn.com, sp.kaola.com, gw.kaola.com
