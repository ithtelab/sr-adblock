[URL Rewrite]
# 屏蔽固件更新
^https?:\/\/myusmile\.online\/user\/version\/requestFirmwareUpdate\/ - reject
# 首页弹窗
^https?:\/\/www\.myusmile\.online\/user\/userTagRecord\/popup - reject

[Map Local]
# 屏蔽更新提示
^https?:\/\/myusmile\.online\/user\/version\/requestAppUpdate data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 商城页弹窗
^https?:\/\/wemallh5\.usmile\.com\/api\/sp-portal\/store\/usmile\/activity\/dayCheck\?pop data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# 我的页推广
usmile = type=http-response,pattern=^https?:\/\/www\.myusmile\.online\/user\/plaqueTopic\/selectByType,script-path=https://raw.githubusercontent.com/ithtelab/sr-adblock/release/vendor/zirawell/R-Store/main/Res/Scripts/AntiAd/usmile.js

[MITM]
hostname = %APPEND% myusmile.online, wemallh5.usmile.com, www.myusmile.online
