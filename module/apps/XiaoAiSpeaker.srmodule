#!name=XiaoAiSpeaker 去广告
#!desc=只针对 XiaoAiSpeaker 的去广告模块，出问题时可以单独停用而不影响其他 App
#!author=sr-adblock-factory（原始规则来自 可莉/奶思 wool_scripts）
#!homepage=https://raw.githubusercontent.com/ithtelab/sr-adblock
#!update=2026-09-26

# ==========================================================================
#  本文件由 sr-adblock-factory 合并生成，请勿手工编辑
#  生成时间: 2026-09-26 07:16:51
#
#  合并来源：
#    - fmz200/wool_scripts split/partX/XiaoAiSpeaker.sgmodule
#
#  规模：
#    [Rule]                 1
#    [URL Rewrite]          2
#    [Map Local]            1
#    [MITM]                 1
#
#  在小火箭里的装法：
#    只想去掉 XiaoAiSpeaker 的广告、不想装总模块时用这个
#    导入方式与总模块相同（配置 → 模块 → + → 粘贴链接）
# ==========================================================================

[Rule]
DOMAIN,mistat.xiaomi.com,REJECT

[URL Rewrite]
^https?:\/\/(info\.mina\.xiaoaisound|marketing-aibox\.v\.mitvos)\.com\/advertise(?!\/banner) - reject
^https?:\/\/(info\.mina\.xiaoaisound|marketing-aibox\.v\.mitvos)\.com\/payGuide\/userCenter - reject

[Map Local]
^https?:\/\/(info\.mina\.xiaoaisound|marketing-aibox\.v\.mitvos)\.com\/popup data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% info.mina.xiaoaisound.com, marketing-aibox.v.mitvos.com
