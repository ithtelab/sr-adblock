什么值得买去广告 = type=http-response,pattern=^https?:\/\/user-api\.smzdm\.com\/vip\/creator_user_center,script-path=https://raw.githubusercontent.com/ithtelab/sr-adblock/release/vendor/fmz200/wool_scripts/main/Scripts/smzdm/smzdm_ads.js,requires-body=true,timeout=60
