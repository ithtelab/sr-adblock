[Rule]
DOMAIN,180.76.76.200,REJECT
# 屏蔽域名dns查询, REJECT
IP-CIDR,180.76.76.200/32,REJECT,no-resolve

[Script]
贴吧json = type=http-response,pattern=^http(s:\/\/tiebac|:\/\/c\.tieba)\.baidu\.com\/(c\/(s\/sync|f\/(ad\/getSplashAd|frs\/(page|threadlist|generalTabList)|pb\/(pic)?page|excellent\/personalized))$|tiebaads\/commonbatch\?),script-path=https://raw.githubusercontent.com/ithtelab/sr-adblock/release/vendor/app2smile/rules/master/js/tieba-json.js,requires-body=true,timeout=10
贴吧proto = type=http-response,pattern=^http(s:\/\/tiebac|:\/\/c\.tieba)\.baidu\.com\/c\/(b\/ad\/adBid|f\/(frs\/(page|threadlist|generalTabList)|ad\/getFeedAd|pb\/page|excellent\/personalized))\?cmd,script-path=https://raw.githubusercontent.com/ithtelab/sr-adblock/release/vendor/app2smile/rules/master/js/tieba-proto.js,requires-body=true,binary-body-mode=true,timeout=10,argument=[{{{per_filter_video_thread}}}]

[MITM]
hostname = %APPEND% tiebac.baidu.com, c.tieba
