#!name=Yiche 去广告
#!desc=只针对 Yiche 的去广告模块，出问题时可以单独停用而不影响其他 App
#!author=sr-adblock-factory（原始规则来自 可莉/奶思 wool_scripts）
#!homepage=https://raw.githubusercontent.com/ithtelab/sr-adblock
#!update=2026-09-26

# ==========================================================================
#  本文件由 sr-adblock-factory 合并生成，请勿手工编辑
#  生成时间: 2026-09-26 07:16:51
#
#  合并来源：
#    - fmz200/wool_scripts split/partY/Yiche.sgmodule
#
#  规模：
#    [Rule]                 6
#    [Map Local]            3
#    [MITM]                 1
#
#  在小火箭里的装法：
#    只想去掉 Yiche 的广告、不想装总模块时用这个
#    导入方式与总模块相同（配置 → 模块 → + → 粘贴链接）
# ==========================================================================

[Rule]
DOMAIN,adx.yiche.com,REJECT
DOMAIN,log.ycapp.yiche.com,REJECT
DOMAIN-SUFFIX,bglog.bitauto.com,REJECT
DOMAIN-SUFFIX,g.bitauto.com,REJECT
DOMAIN-SUFFIX,gimg.bitauto.com,REJECT
DOMAIN-SUFFIX,gstat.bitauto.com,REJECT

[Map Local]
^https?:\/\/api\.ycapp\.yiche\.com\/appnews\/getadlist data-type=tiny-gif status-code=200
^https?:\/\/api\.ycapp\.yiche\.com\/yicheapp\/getadlist data-type=tiny-gif status-code=200
^https?:\/\/cheyouapi\.ycapp\.yiche\.com\/appforum\/getusermessagecount data-type=tiny-gif status-code=200

[MITM]
hostname = %APPEND% api.ycapp.yiche.com, cheyouapi.ycapp.yiche.com
